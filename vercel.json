{
  "version": 2,
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/main.ts",
      "methods": ["GET", "POST", "PUT", "PATCH", "HEAD", "DELETE", "OPTIONS"]
    }
  ],
  "crons": [
    {
      "path": "/tasks/run-pending-return",
      "schedule": "30 13 * * *"
    }
  ]
}
